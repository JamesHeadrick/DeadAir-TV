# TMDB v3 API key or v4 read access token (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Watch-provider region to check (ISO 3166-1)
WATCH_REGION=US

# Optional tuning
# EPISODE_REFRESH_DAYS=7
# PROVIDER_CHECK_HOURS=24

# Phase 2: "Play on TV" via adb against a Chromecast with Google TV
ENABLE_ADB=false
TV_IP=
# ADB_PORT=5555
