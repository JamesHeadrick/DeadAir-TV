# Optional: settings can go here instead of under `environment:` in
# docker-compose.yml. Copy to .env next to docker-compose.yml.

# TMDB v3 API key or v4 read access token (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Optional: create the first admin account at startup (only if no users exist).
# Leave blank to create it in the browser on first visit instead.
ADMIN_USER=
ADMIN_PASSWORD=

# Optional: run a different image, e.g. a pull request's build to test it.
# DEADAIR_IMAGE=ghcr.io/jamesheadrick/deadair-tv:pr-3

# Watch-provider region to check (ISO 3166-1)
WATCH_REGION=US

# Optional tuning
# EPISODE_REFRESH_DAYS=7
# PROVIDER_CHECK_HOURS=24

# Phase 2: "Play on TV" via adb against a Chromecast with Google TV
ENABLE_ADB=false
TV_IP=
# ADB_PORT=5555
